PRODUCT_BUNDLE_IDENTIFIER_TESTS = com.yourcompany.YourAppNameTests
PRODUCT_BUNDLE_IDENTIFIER_UI_TESTS = com.yourcompany.YourAppNameUITests
DEVELOPMENT_TEAM = YOUR_TEAM_ID
